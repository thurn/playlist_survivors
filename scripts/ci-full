#!/bin/sh
# Tollgate's release stage: every check, on the newest `staging` tip, asynchronously. A pass moves
# `release` and remote master; a failure is fixed forward by a ci-fix bead (AGENTS.md). Nobody
# waits for it. Run it locally only when a change touches CI scripts, the Tollgate policy,
# workspace-wide configuration or shared test infrastructure.
#
#   scripts/ci-full [ts|analysis|native]    # one section (a Tollgate release step each), or all
#
# The Playwright e2e tests stay out: Chromium starts its own process session, which Tollgate
# rejects. Run `npm run test:e2e` by hand.
set -eu
cd "$(dirname "$0")/.."
. scripts/lib/changes.sh
section="${1:-all}"
# Pass stamps for the TS section, keyed by its inputs' hash (outside the slots, so they persist).
STAMPS="${PS_CI_STAMPS:-$HOME/Library/Caches/playlist-survivors/ci-stamps}"

case "$section" in
  all|ts|analysis|native) ;;
  *) echo "usage: scripts/ci-full [ts|analysis|native]" >&2; exit 2 ;;
esac

# The TS section is skipped when its inputs (every TS path at HEAD, node and npm) are identical
# to a commit that passed it before: the TS game is frozen, and native-only commits would rerun
# about 250 s of checks on the same inputs. PS_CI_FULL_FORCE=1 runs it regardless.
if [ "$section" = all ] || [ "$section" = ts ]; then
  hash=$(ts_inputs_hash)
  if [ -n "$hash" ] && [ -f "$STAMPS/ts-$hash" ] && [ "${PS_CI_FULL_FORCE:-0}" != 1 ]; then
    echo "ci-full ts: inputs $hash passed at $(cat "$STAMPS/ts-$hash"); skipping"
  else
    echo "ci-full ts: inputs ${hash:-(uncommitted changes)}"
    npm ci --no-audit --no-fund --prefer-offline
    npm run check
    npm run check:content
    npm run check:assets
    # The level's seed with causality and determinism, then three more seeds.
    npm run check:seeds
    # Play mode on four seeds (the moderate player's signature moments, the casual player's
    # finale), and the curve and groove averaged over eight.
    npm run check:play
    # Reactive mode: causality, determinism, the shipped streams and sounds on committed beats.
    npm run check:reactive
    npm run build
    if [ -n "$hash" ]; then
      mkdir -p "$STAMPS"
      echo "$(git rev-parse --short HEAD) $(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STAMPS/ts-$hash"
    fi
  fi
fi

# The Python tooling: the analysis tool and the friction ledger.
if [ "$section" = all ] || [ "$section" = analysis ]; then
  npm run check:analysis
  npm run check:songmap
  scripts/friction validate
  uv run --directory tools/analysis ruff check ../../scripts/friction ../../scripts/test_friction.py
  uv run --no-project python -m unittest scripts/test_friction.py
  uv run --no-project python -m unittest scripts/test_check_conflict_markers.py
  uv run --no-project python -m unittest scripts/test_changes.py
fi

# The native workspace: every crate's clippy and tests, the pure crates' purity, unused
# dependencies, and a release build of the app. Each phase adds its release-stage checks here
# (docs/design/native-app.md, "Automated Checks"): stage and corpus parity (A), the oracle sweep,
# causality and playability (B), visual parity (C1), sessions (D3), `ps bench`, Delayed listening
# (E). Tollgate's ci-full-native step sets CARGO_TARGET_DIR to a persistent directory.
if [ "$section" = all ] || [ "$section" = native ]; then
  uv run --directory tools/analysis ruff check ../../native/scripts/crates ../../native/scripts/test_crates.py
  uv run --no-project python -m unittest native/scripts/test_crates.py
  (
    cd native
    cargo fmt --all --check
    scripts/crates purity
    cargo clippy --locked --workspace --all-targets -- -D warnings
    # (With the release-only stage parity tests the gate skips: #[ignore = "release: ..."].)
    cargo test --locked --workspace -- --include-ignored
    cargo machete
    cargo build --locked --release -p app
  )
  # Corpus parity (A7, docs/design/native-app.md "Corpus parity"): the Rust analyzer over a sample
  # of tracks against Python's committed streams (the margins, at D = 0; the live delay's cost is
  # measured by hand into the design's appendix), in the utility QoS class (the
  # background class keeps to the efficiency cores and took over an hour; a warm gate check under
  # it took 14.8 s against 11 s, hv-t8o8.12), and
  # skipped when its inputs (the analyzer, the CLI, the models, the workspace's build files, the
  # streams and audio, Python's decoding and its lock file)
  # match a commit that passed it.
  # A fixed sample: steady (house, drum and bass), a swing groove, an accelerando, two classical
  # pieces, two hard tracks. The whole corpus (--all) took over 30 minutes on a loaded host;
  # run it by hand (`ps analysis-parity --all`) when the analyzer's accuracy is in question.
  # Delayed listening at the chosen M (E1) rides on the same runs: its lead check fails the step.
  PARITY_DELAYED="--delayed 3"
  PARITY_TRACKS=house-128,dnb-174,hiphop-92-swing,accelerando-100-140,orpheus-galop,beethoven-fifth,notjam-klepto-linda-caverns-b,notjam-crystal-caverns
  parity=$(
    {
      echo "$PARITY_TRACKS $PARITY_DELAYED"
      git ls-tree -r HEAD native/crates/analysis native/crates/cli native/models native/Cargo.toml \
      native/Cargo.lock native/rust-toolchain.toml public/reactive public/audio \
      tools/analysis/src/ps_analysis/stream.py tools/analysis/src/ps_analysis/pcm.py \
      tools/analysis/uv.lock
    } | shasum -a 256 | cut -d ' ' -f 1
  )
  if [ -z "$(git status --porcelain --untracked-files=no)" ] && [ -f "$STAMPS/parity-$parity" ] &&
    [ "${PS_CI_FULL_FORCE:-0}" != 1 ]; then
    echo "ci-full native: corpus parity inputs $parity passed at $(cat "$STAMPS/parity-$parity"); skipping"
  else
    out="$HOME/Library/Caches/playlist-survivors/parity/$(git rev-parse --short HEAD)"
    (cd native && taskpolicy -c utility cargo run --locked --release -p cli -- analysis-parity --tracks "$PARITY_TRACKS" $PARITY_DELAYED --jobs 8 --check --out "$out")
    mkdir -p "$STAMPS"
    # (Only a clean tree's pass vouches for HEAD's inputs.)
    if [ -z "$(git status --porcelain --untracked-files=no)" ]; then
      echo "$(git rev-parse --short HEAD) $(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STAMPS/parity-$parity"
    fi
  fi
fi
