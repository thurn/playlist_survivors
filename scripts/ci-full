#!/bin/sh
# Enact's slow CI: every check of Rhythm Champions, on the newest `staging` tip, asynchronously. A
# pass moves remote master; a failure is fixed forward by a Steward bead (AGENTS.md). Nobody waits
# for it. Run it locally only when a change touches CI scripts, `.enact.toml`, workspace-wide
# configuration or shared test infrastructure. The frozen projects (AGENTS.md) have no CI; the vendor
# guard still covers every Unity project.
#
#   scripts/ci-full [LANE ...]    # those lanes, or all of them
#
# The lanes run in parallel, each step timed (scripts/lib/lanes.sh). The budget is 300 s of wall time
# (docs/champions/plan.md, CI and Checks; CI_BUDGET_S overrides it): a run over it fails, and the
# Steward fixing that speeds a step up or moves it to a cheaper lane. `.enact.toml`'s slow command sets
# CARGO_TARGET_DIR to a persistent directory, which it prunes after the run.
set -eu
cd "$(dirname "$0")/.."
LANES_SCRIPT=ci-full
. scripts/lib/lanes.sh
ALL="plugin sim tools unity guard"
budget="${CI_BUDGET_S:-300}"
started=$(date +%s)

champions() { uv run --quiet --project rhythm_champions/tools champions "$@"; }
# (In the plugin's folder, for its rust-toolchain.toml.)
plugin() { (cd rhythm_champions/plugin && "$@"); }
# Rhythm Champions is Mac only (plan.md, Decision 9): elsewhere (Cygnus, the Windows desktop) the
# plugin and unity lanes pass as skipped, saying so, and slow CI checks the rest.
off_mac() {
  [ "$(uname -s)" != Darwin ] && echo "ci-full: $_lane skipped: Rhythm Champions builds only on macOS"
}

# The music plugin's workspace: rustfmt, clippy, and every test (in release, the slow ones its
# #[ignore] keeps out of check-fast included), in parallel under nextest (the crates have no doctests).
lane_plugin() {
  if off_mac; then return 0; fi
  step fmt plugin cargo fmt --all --check &&
    step clippy plugin cargo clippy --locked --workspace --all-targets -- -D warnings &&
    step tests plugin cargo nextest run --locked --release --workspace --run-ignored all --status-level fail
}

# The sim under dotnet: its tests, then every recorded session replayed to its hash (exit 2: recorded
# by the player, whose runtime may round differently, so only the player's replay can judge it).
lane_sim() {
  step build dotnet build rhythm_champions/dotnet --nologo -v q &&
    step tests dotnet test rhythm_champions/dotnet --no-build --nologo -v q &&
    step replays replay_sessions
}
replay_sessions() {
  for s in rhythm_champions/sessions/*/; do
    dotnet run --no-build --project rhythm_champions/dotnet/Champions.Replay -- "$s" || [ $? = 2 ] || return 1
  done
}

# The champions tools and the scripts' own tests.
lane_tools() {
  step ruff uv run --directory rhythm_champions/tools ruff check . &&
    step pytest uv run --directory rhythm_champions/tools pytest -q &&
    step scripts uv run --no-project python -m unittest scripts/test_check_conflict_markers.py \
      scripts/test_prune_cargo_target.py scripts/test_ci_full.py
}

# Unity, windowless in batch mode, from the warm Library and baked caches (`champions setup`): the
# EditMode tests, where a skip fails too; the Mono player built with a clean build cache, which counts
# its shader variants against the budget of 300; that player's fixed-time run; then the Library,
# with the build's shader cache, saved as the warm one for the next worktree or run (plan.md, Build
# Policy). Later beads add the scripted scenes' stills, a recorded session's replay and `champions look`.
lane_unity() {
  if off_mac; then return 0; fi
  step setup champions setup --no-unity &&
    step editmode champions test --cold --no-skips &&
    step build champions check --variants &&
    step player player_run &&
    step replay replay_run &&
    step stills stills_run &&
    step look look_report &&
    step library champions library save --built
}
# 10 s of the plugin's fixture song at fixed time, which plays it through the plugin silently, with
# stills at 1 s and 10 s: the player must exit 0, keep both and log no exception.
# The player replays every recorded session (rhythm_champions/sessions/*/) through its presenters, with no music, to the
# hash recorded in .NET: the sim settles the same doubles under Mono (ps-6y2.21).
replay_run() {
  sessions=$(ls -d rhythm_champions/sessions/*/ | sed 's:/$::' | paste -sd, -)
  champions play --headless --replay "$sessions" --replay-speed 2 || {
    grep -n "Replay:" rhythm_champions/Logs/player.log
    return 1
  }
  if grep -n Exception rhythm_champions/Logs/player.log; then
    echo "ci-full: the replay logged an exception (rhythm_champions/Logs/player.log)"
    return 1
  fi
}
# Every scripted scene's stills, in one launch (champions stills), into the ignored captures/stills.
stills_run() {
  champions stills || return 1
  if grep -n Exception rhythm_champions/Logs/stills.log; then
    echo "ci-full: the stills logged an exception (rhythm_champions/Logs/stills.log)"
    return 1
  fi
}
# champions look on the stills: a report of how they stray from the guide values, never a failure (design.md, Judgment
# over rules; ps-6y2.41). Its report is rhythm_champions/Logs/look.txt.
look_report() {
  champions look captures/stills > rhythm_champions/Logs/look.txt 2>&1 ||
    echo "ci-full: champions look reports strays (a diagnostic: rhythm_champions/Logs/look.txt)"
  return 0
}
player_run() {
  stills="$PWD/rhythm_champions/Logs/ci-stills"
  rm -rf "$stills"
  champions play --headless --fixed-time --file rhythm_champions/plugin/fixtures/house-128.ogg \
    --capture-stills "$stills" --stills-at 1,10 --seconds 11 || return 1
  kept=$(find "$stills" -name '*.jpg' 2>/dev/null | wc -l | tr -d ' ')
  if [ "$kept" != 2 ]; then
    echo "ci-full: the player kept $kept of its 2 stills (rhythm_champions/Logs/player.log)"
    return 1
  fi
  if grep -n Exception rhythm_champions/Logs/player.log; then
    echo "ci-full: the player logged an exception (rhythm_champions/Logs/player.log)"
    return 1
  fi
}

# The vendor guard over the tree and over the commits since the last green master.
lane_guard() {
  step tree champions guard --tree HEAD &&
    step range champions guard --range origin/master..HEAD
}

lanes="${*:-$ALL}"
for name in $lanes; do
  case " $ALL " in
    *" $name "*) ;;
    *) echo "usage: scripts/ci-full [$(echo $ALL | tr ' ' '|') ...]" >&2; exit 2 ;;
  esac
done
lanes_init
for name in $lanes; do lane "$name" "lane_$name"; done
status=0
lanes_wait || status=1
elapsed=$(( $(date +%s) - started ))
echo "ci-full: $elapsed s, budget $budget s"
if [ "$elapsed" -gt "$budget" ]; then
  echo "ci-full: FAILED: over the $budget s budget; speed the long pole up or move a step to a cheaper lane"
  status=1
fi
exit $status
