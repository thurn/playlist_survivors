#!/bin/sh
# The fast local check (budget 60 s): `enact push` runs it on the rebased tree. It replaces running
# the whole suite locally. Diff-aware, from the paths that differ from the branch's base
# (scripts/lib/changes.sh), committed or not: conflict markers in any changed file first, then these
# lanes in parallel, each step timed (scripts/lib/lanes.sh):
# - guard: the vendor guard (rhythm_champions/tools, covering every Unity project: rhythm_champions/
#   and the frozen game/, demo3d/, demo2d/, stylelab/ and herocap/), always, over the commits since
#   the base and the index;
# - tools: the champions tools' lint and tests, when rhythm_champions/tools changed;
# - scripts: the scripts' own tests, when a script they test changed;
# - sim: Rhythm Champions' sim tests (rhythm_champions/dotnet/), the recorded session's replay among
#   them, when its sim, tests, content or sessions changed;
# - plugin: the music plugin (rhythm_champions/plugin/, its own Cargo workspace): rustfmt, clippy
#   (-D warnings) and its tests under nextest (its #[ignore]d release tests are slow CI's), when it
#   changed.
# The frozen projects (AGENTS.md) have no checks. Slow CI (scripts/ci-full, on the `staging` tip)
# runs the rest.
set -eu
cd "$(dirname "$0")/.."
LANES_SCRIPT=check-fast
. scripts/lib/changes.sh
. scripts/lib/lanes.sh
started=$(date +%s)
changes_init
trap 'rm -f "$CHANGES_FILE" "${list:-}"' EXIT
list=$(mktemp)

# Conflict markers a rebase left in any changed file.
changes_existing '.' > "$list"
if [ -s "$list" ]; then
  while IFS= read -r f; do set -- "$@" "$f"; done < "$list"
  scripts/check-conflict-markers "$@"
  set --
fi

champions() { uv run --quiet --project rhythm_champions/tools champions "$@"; }
# (In the plugin's folder, for its rust-toolchain.toml.)
plugin() { (cd rhythm_champions/plugin && "$@"); }

# The vendor guard (docs/archive/tech-demo-3d/vendor-assets.md), whatever changed: a vendor file is
# caught by its hash anywhere in the tree.
lane_guard() {
  { [ -z "$CHANGES_BASE" ] || step range champions guard --range "$CHANGES_BASE..HEAD"; } &&
    step index champions guard --index
}
lane_tools() {
  step ruff uv run --directory rhythm_champions/tools ruff check . &&
    step pytest uv run --directory rhythm_champions/tools pytest -q
}
lane_scripts() {
  step tests uv run --no-project python -m unittest scripts/test_check_conflict_markers.py \
    scripts/test_prune_cargo_target.py scripts/test_ci_full.py
}
lane_sim() {
  step tests dotnet test rhythm_champions/dotnet --nologo -v q
}
lane_plugin() {
  step fmt plugin cargo fmt --all --check &&
    step clippy plugin cargo clippy --locked --workspace --all-targets -- -D warnings &&
    step tests plugin cargo nextest run --locked --workspace --status-level fail
}

lanes_init
lane guard lane_guard
# The tools' tests read the palette, the cast and the look's thresholds too.
if changes_match '^(rhythm_champions/tools/|rhythm_champions/Content/(palette|enemies)\.json$|docs/champions/style-thresholds\.json$)'; then
  lane tools lane_tools
fi
if changes_match '^scripts/(check-conflict-markers|prune-cargo-target|ci-full|lib/lanes\.sh|test_(check_conflict_markers|prune_cargo_target|ci_full)\.py)$'; then
  lane scripts lane_scripts
fi
if changes_match '^rhythm_champions/(Assets/Champions/Sim/|dotnet/|Content/|sessions/)'; then lane sim lane_sim; fi
if changes_match '^rhythm_champions/plugin/'; then lane plugin lane_plugin; fi
lanes_wait
echo "check-fast: passed in $(( $(date +%s) - started )) s (budget 60 s)"
