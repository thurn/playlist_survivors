#!/bin/sh
# The fast local check (budget 60 s): run it once, on the final tree, before `tg candidate`.
# It replaces running the whole suite locally. Diff-aware, from the paths that differ from the
# branch's base (scripts/lib/changes.sh), committed or not:
# - Conflict markers in any changed file (scripts/check-conflict-markers).
# - The asset baker (tools/baker): its lint, typecheck and the baked assets' check.
# - The analysis tool: ruff on the changed Python files, the test modules of the changed modules,
#   and the song map's check when the song maps changed.
# - The friction ledger: its records and scripts/friction's tests, when either changed.
# - native/scripts/check-fast when native/ changed and the workspace has one (F4 adds it).
# Tollgate's gate stage (scripts/ci-gate) and release stage (scripts/ci-full) run the rest.
set -eu
cd "$(dirname "$0")/.."
. scripts/lib/changes.sh
started=$(date +%s)
changes_init
trap 'rm -f "$CHANGES_FILE" "${list:-}"' EXIT
list=$(mktemp)

# Conflict markers a rebase left in any changed file.
changes_existing '.' > "$list"
if [ -s "$list" ]; then
  while IFS= read -r f; do set -- "$@" "$f"; done < "$list"
  scripts/check-conflict-markers "$@"
  set --
fi
if changes_match '^scripts/(check-conflict-markers|test_check_conflict_markers\.py)$'; then
  uv run --no-project python -m unittest scripts/test_check_conflict_markers.py
fi

if changes_baker; then
  if [ ! -d node_modules ]; then
    echo "check-fast: node_modules is missing; run npm ci first" >&2
    exit 1
  fi
  npm run check
fi

if changes_analysis && [ "$CHANGES_UNKNOWN" = 1 ]; then
  uv run --directory tools/analysis pytest -q
  uv run --directory tools/analysis ruff check .
  uv run --project tools/analysis ps-analysis check songs/orpheus-galop/songmap.json
elif changes_analysis; then
  changes_existing '^tools/analysis/.*\.py$' | sed 's|^tools/analysis/||' > "$list"
  if [ -s "$list" ]; then
    while IFS= read -r f; do set -- "$@" "$f"; done < "$list"
    uv run --directory tools/analysis ruff check -- "$@"
    set --
    # Each changed test module, and the test module named after each changed module.
    while IFS= read -r f; do
      case "$f" in
        tests/test_*.py) set -- "$@" "$f" ;;
        src/ps_analysis/*.py)
          t="tests/test_$(basename "$f")"
          [ -f "tools/analysis/$t" ] && set -- "$@" "$t" ;;
      esac
    done < "$list"
    if [ $# -gt 0 ]; then uv run --directory tools/analysis pytest -q -- "$@"; fi
    set --
  fi
  if changes_match '^songs/'; then
    uv run --project tools/analysis ps-analysis check songs/orpheus-galop/songmap.json
  fi
fi

if changes_friction; then
  scripts/friction validate
  uv run --directory tools/analysis ruff check ../../scripts/friction ../../scripts/test_friction.py
  uv run --no-project python -m unittest scripts/test_friction.py
fi

if changes_native && [ -x native/scripts/check-fast ]; then
  native/scripts/check-fast
fi

echo "check-fast: passed in $(( $(date +%s) - started )) s"
