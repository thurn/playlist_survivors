#!/bin/sh
# Tollgate's gate stage (budget about 60 s): it runs on every candidate and blocks promotion to
# `staging`. Path-gated (scripts/lib/changes.sh): each section runs when its paths differ from the
# base, and every section when the base is unknown.
# - The asset baker (tools/baker): install, lint, typecheck, the baked assets' check.
# - The analysis tool: ruff and the song map's check.
# - Every section: conflict markers in the changed files.
# - The friction ledger (native/evidence/, scripts/friction): its records and its tests.
# - Native (native/, and the content it reads): native/scripts/check-fast, which formats, checks
#   the pure crates' purity, and runs clippy and the tests of the crates the diff touches and
#   their dependents. Tollgate's gate step sets CARGO_TARGET_DIR to a persistent directory.
# - The 3D demo's vendor guard (docs/tech-demo-3d/vendor-assets.md), always: over the commits since
#   the base and the whole tree, after rebuilding the machine's sync record when the demo's
#   manifest changed; and its tools' lint when demo3d/ changed.
# The release stage (scripts/ci-full) runs everything, the slow checks included, on `staging`.
set -eu
cd "$(dirname "$0")/.."
. scripts/lib/changes.sh
started=$(date +%s)
changes_init
trap 'rm -f "$CHANGES_FILE" "${list:-}"' EXIT

# Conflict markers a rebase left in any changed file, whatever the section.
list=$(mktemp)
changes_existing '.' > "$list"
if [ -s "$list" ]; then
  while IFS= read -r f; do set -- "$@" "$f"; done < "$list"
  scripts/check-conflict-markers "$@"
  set --
fi

if changes_baker; then
  echo "ci-gate: baker section"
  npm ci --no-audit --no-fund --prefer-offline
  npm run check
else
  echo "ci-gate: the baker and its inputs unchanged; skipping the baker section"
fi

if changes_analysis; then
  echo "ci-gate: analysis section"
  uv run --directory tools/analysis ruff check .
  uv run --project tools/analysis ps-analysis check songs/orpheus-galop/songmap.json
else
  echo "ci-gate: tools/analysis and songs/ unchanged; skipping the analysis section"
fi

if changes_friction; then
  echo "ci-gate: friction section"
  scripts/friction validate
  uv run --directory tools/analysis ruff check ../../scripts/friction ../../scripts/test_friction.py
  uv run --no-project python -m unittest scripts/test_friction.py
fi

if changes_native; then
  echo "ci-gate: native section"
  native/scripts/check-fast
else
  echo "ci-gate: native/ and its content unchanged; skipping the native section"
fi

echo "ci-gate: vendor guard"
if changes_demo3d_manifest; then
  uv run --quiet --project demo3d/tools demo3d sync --record-only
fi
if [ -n "$CHANGES_BASE" ]; then
  uv run --quiet --project demo3d/tools demo3d guard --range "$CHANGES_BASE..HEAD"
fi
uv run --quiet --project demo3d/tools demo3d guard --tree HEAD
if changes_demo3d; then
  echo "ci-gate: demo3d section"
  uv run --directory demo3d/tools ruff check .
else
  echo "ci-gate: demo3d/ unchanged; skipping the demo3d section"
fi

echo "ci-gate: passed in $(( $(date +%s) - started )) s"
