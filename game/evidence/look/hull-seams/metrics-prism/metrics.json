{
 "palette": "spectrum.json",
 "preset": "prism",
 "thresholds": {
  "source": "docs/archive/design/neon-look-style.md, Rules and Thresholds (ps-wnj.1); halo_min, monster_form_min and swarm_separation_min calibrated on v2 by ps-wnj.21 (demo3d/evidence/look/metrics); the restraint rules (floor_p99, background_light, flash_frames) by ps-wnj.24 (game/evidence/look/restraint, demo3d/evidence/look/restraint); halo moved to impact frames by ps-wnj.19 and bright_share_min's sparse stills by ps-wnj.29 (demo3d/evidence/look/trailer); monster_form_min's and swarm_separation_min's tiles scaled to the bodies' height on screen by ps-wnj.30 (game/evidence/look/body-tiles); swarm_separation_min's hull seams and its four dense tiles by ps-wnj.31 (demo3d/evidence/look/hull-seams)",
  "presets": [
   "edge",
   "solid",
   "hologram",
   "prism"
  ],
  "pairings": {
   "ion": "edge",
   "arcade": "solid",
   "phosphor": "hologram",
   "spectrum": "prism"
  },
  "rules": {
   "floor_p50_max": {
    "value": 8,
    "why": "the floor is void"
   },
   "floor_p90_max": {
    "value": 30,
    "why": "rings and breaths included, the floor stays under ground light"
   },
   "floor_p99_max": {
    "value": 20,
    "prism": 26,
    "why": "the grid's lines are a quiet background (ps-wnj.24); prism's gems halo onto the floor"
   },
   "background_light_max": {
    "value": 0.15,
    "why": "the world never drowns the swarm: the background carries a small share of the frame's light (ps-wnj.24)"
   },
   "frame_p25_max": {
    "value": 6,
    "unless": "floor_p50",
    "why": "the video fallback for the floor: the darkest quarter is void"
   },
   "black_share_min": {
    "value": 0.3,
    "solid": 0.25,
    "why": "a swarm is lit things with dark between them"
   },
   "bright_share_max": {
    "edge": 0.22,
    "solid": 0.32,
    "hologram": 0.22,
    "prism": 0.28,
    "why": "light comes from emitters, not a lit world"
   },
   "bright_share_min": {
    "value": 0.04,
    "unless_below": {
     "monster_share": 0.1
    },
    "why": "something emits; a staged sparse still (the duel's three elites, monsters on 3% of the frame) is judged by its hero margin and readability instead (ps-wnj.29)"
   },
   "clipped_max": {
    "value": 0.02,
    "why": "white is earned"
   },
   "clipped_impact_max": {
    "value": 0.12,
    "metric": "clipped",
    "on": "impact",
    "why": "even an impact frame is not a white-out"
   },
   "clipped_blob_max": {
    "value": 0.005,
    "why": "no blown-out region outside impact frames"
   },
   "white_max": {
    "value": 0.02,
    "why": "white is earned: impact frames, sparks and the blade's flare"
   },
   "halo_impact_min": {
    "value": 15,
    "metric": "halo",
    "on": "impact",
    "why": "emitters glow at a special moment: the post's halo flares on its impact frame (ps-wnj.19); steady frames are calm (ps-wnj.24), so no steady halo rule"
   },
   "families_max": {
    "value": 4,
    "why": "the hue budget: the zone's key and three enemy families"
   },
   "key60_min": {
    "value": 0.55,
    "why": "each frame has a colour key"
   },
   "key60_median_min": {
    "value": 0.62,
    "on": "cut",
    "why": "a cut keys as GW3 does"
   },
   "palette_conformance_min": {
    "value": 0.85,
    "prism": 0.75,
    "why": "everything drawn takes its colour from a role"
   },
   "shot_floor_range_max": {
    "value": 6,
    "on": "cut",
    "why": "one world across the shots, not stitched parts"
   },
   "flash_frames_max": {
    "value": 0.5,
    "on": "cut",
    "why": "flashes are for special moments: at most half the steady stills hold a near-white region over 0.3% of the frame (ps-wnj.24)"
   },
   "hero_margin_min": {
    "value": 5,
    "why": "the hero is the brightest thing on screen"
   },
   "monster_form_min": {
    "value": 30,
    "solid": 20,
    "why": "a monster shows form, not flat paint (in tiles grown with the bodies' height on screen)"
   },
   "swarm_separation_min": {
    "value": 13,
    "unless_below": {
     "dense_tiles": 4
    },
    "why": "a dense clump of one type reads as individuals, not a blob (in tiles grown with that type's height on screen; fewer than four dense tiles are no clump)"
   },
   "readability_min": {
    "value": 17,
    "why": "monsters stand off the ground round them (TD15)"
   }
  }
 },
