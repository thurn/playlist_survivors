<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- The level-up's cards (LevelUpCards.cs), over the frozen run, until the HUD draws them. Cards are added in code. -->
    <Style src="../Title/Title.uss" />
    <Style src="Cards.uss" />
    <ui:VisualElement name="cards-root" class="cards-veil">
        <ui:Label name="heading" text="LEVEL UP" class="cards__heading" />
        <ui:VisualElement name="cards" class="cards" />
        <ui:Label class="hint" text="Left / Up / Right choose   ·   Space or Enter takes it   ·   play resumes on the next beat" />
    </ui:VisualElement>
</ui:UXML>
