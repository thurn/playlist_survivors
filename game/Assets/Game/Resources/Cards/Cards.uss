/* The level-up's cards: the frozen run dimmed less than the pause menu's, three crystal-edged
   cards in a row that flip in (scale x from 0) on their beats; the selected one lit white. */

.cards-veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 5, 11, 0.5);
    align-items: center;
    justify-content: center;
}

.cards__heading {
    font-size: 44px;
    -unity-font-style: bold;
    letter-spacing: 14px;
    color: rgb(240, 246, 255);
    -unity-text-align: middle-center;
    margin-bottom: 32px;
}

.cards {
    flex-direction: row;
    justify-content: center;
}

.card {
    width: 270px;
    height: 330px;
    margin: 0 16px;
    padding: 30px 18px 22px 18px;
    align-items: center;
    background-color: rgba(10, 14, 28, 0.92);
    border-width: 1px;
    border-color: rgba(150, 200, 255, 0.25);
    opacity: 0;
    scale: 0 1;
    transition-property: scale, opacity, border-color, background-color;
    transition-duration: 0.12s, 0.12s, 0.08s, 0.08s;
    transition-timing-function: ease-out-back, linear, linear, linear;
}

.card--shown {
    opacity: 1;
    scale: 1 1;
}

.card--selected {
    background-color: rgba(30, 44, 76, 0.95);
    border-color: rgba(235, 248, 255, 0.95);
}

.card__gem {
    width: 54px;
    height: 54px;
    rotate: 45deg;
    border-width: 2px;
    margin: 12px 0 40px 0;
}

.card__gem--weapon {
    background-color: rgba(110, 210, 255, 0.35);
    border-color: rgb(170, 235, 255);
}

.card__gem--passive {
    background-color: rgba(200, 140, 255, 0.35);
    border-color: rgb(225, 190, 255);
}

.card__gem--heal {
    background-color: rgba(255, 130, 170, 0.35);
    border-color: rgb(255, 190, 210);
}

.card__name {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(245, 248, 255);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0 0 10px 0;
}

.card__kind {
    font-size: 14px;
    letter-spacing: 4px;
    color: rgba(160, 190, 230, 0.6);
    margin-bottom: 18px;
}

.card__rank {
    font-size: 20px;
    color: rgba(225, 235, 250, 0.85);
    flex-grow: 1;
}

.card__key {
    font-size: 16px;
    letter-spacing: 3px;
    color: rgba(160, 180, 210, 0.45);
}

.card--selected .card__key {
    color: rgba(235, 248, 255, 0.9);
}
