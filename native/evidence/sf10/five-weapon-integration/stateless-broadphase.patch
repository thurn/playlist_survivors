+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn broad_phase_preserves_the_real_capsule_contact_test() {
+        for (x0, y0, x1, y1) in [
+            (0.0, 0.0, 0.0, 0.0),
+            (-100.0, 20.0, 200.0, -50.0),
+            (10_000.0, -10_000.0, 10_000.001, -9999.999),
+        ] {
+            for radius in [0.0, 0.1, 12.0, 100.0] {
+                let shape = Shape::Capsule {
+                    x0,
+                    y0,
+                    x1,
+                    y1,
+                    radius,
+                };
+                let b = expanded_bounds(&shape);
+                for body in [0.0, 1.0, 24.0, 256.0] {
+                    let edge = shape_bounds(&shape);
+                    for dx in [-1000.0, -1e-10, 0.0, 1e-10, 1000.0] {
+                        for x in [x0, x1, edge[0] - 0.5 * body, edge[2] + 0.5 * body] {
+                            for y in [y0, y1, edge[1] - 0.5 * body, edge[3] + 0.5 * body] {
+                                let (x, y) = (x + dx, y + dx);
+                                let original = crate::aim::catches(&shape, x, y, body);
+                                assert_eq!(near_bounds(b, x, y, body) && original, original);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
