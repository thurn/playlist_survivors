+// Conservative broad phase only: near candidates still use the unchanged swept-capsule
+// contact test. Outward padding keeps boundary rounding from rejecting a real contact.
+fn expanded_bounds(shape: &Shape) -> [f64; 4] {
+    let mut b = shape_bounds(shape);
+    let scale = b.iter().map(|x| x.abs()).fold(1.0, f64::max);
+    let pad = 1e-9 + 16.0 * f64::EPSILON * scale;
+    b[0] -= pad;
+    b[1] -= pad;
+    b[2] += pad;
+    b[3] += pad;
+    b
+}
+fn near_bounds(b: [f64; 4], x: f64, y: f64, body_radius: f64) -> bool {
+    let margin = 0.5 * body_radius; // the same hurtbox margin as aim::catches
+    x >= b[0] - margin && x <= b[2] + margin && y >= b[1] - margin && y <= b[3] + margin
+}
