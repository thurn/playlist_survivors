#!/bin/sh
# Builds the app and wraps it in a signed .app, so TCC can grant it System Audio Recording.
#
#   native/scripts/bundle            # -> <target dir>/PlaylistSurvivors.app
#
# Every build is signed by the stable identity from scripts/signing-identity: the grant is keyed
# on the signature's designated requirement (bundle ID plus certificate), so it survives rebuilds.
set -eu
cd "$(dirname "$0")/.."
IDENTITY="${PS_SIGNING_IDENTITY:-Playlist Survivors Dev}"
BUNDLE_ID=ca.thurn.playlist-survivors
TARGET="${CARGO_TARGET_DIR:-target}"
scripts/signing-identity >/dev/null

cargo build --locked --release -p app
APP="$TARGET/PlaylistSurvivors.app"
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$TARGET/release/playlist-survivors" "$APP/Contents/MacOS/playlist-survivors"
# The analyzer's models (the playable slice, docs/design/native-app.md Phase V).
cp models/madmom.bin "$APP/Contents/Resources/madmom.bin"
mkdir -p "$APP/Contents/Resources/assets"
cp ../public/assets/characters.json ../public/assets/characters-0.png \
  ../public/assets/effects.json ../public/assets/effects-0.png \
  ../public/assets/world.json ../public/assets/world-0.png "$APP/Contents/Resources/assets/"
# The game's content and its reactive level (the sim engine, G1).
rm -rf "$APP/Contents/Resources/content" "$APP/Contents/Resources/levels"
cp -R ../content "$APP/Contents/Resources/content"
mkdir -p "$APP/Contents/Resources/levels"
cp ../levels/reactive.yaml ../levels/survivors.yaml "$APP/Contents/Resources/levels/"
rm -rf "$APP/Contents/Resources/sfx"
cp -R ../public/assets/sfx "$APP/Contents/Resources/sfx"
cat >"$APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>$BUNDLE_ID</string>
  <key>CFBundleName</key><string>Playlist Survivors</string>
  <key>CFBundleDisplayName</key><string>Playlist Survivors</string>
  <key>CFBundleExecutable</key><string>playlist-survivors</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleVersion</key><string>0</string>
  <key>CFBundleShortVersionString</key><string>0.0</string>
  <key>LSMinimumSystemVersion</key><string>14.2</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSAudioCaptureUsageDescription</key><string>Playlist Survivors listens to the music you play to find its beat.</string>
  <key>NSMicrophoneUsageDescription</key><string>The latency test listens to the speakers through the microphone.</string>
</dict>
</plist>
PLIST
codesign --force --sign "$IDENTITY" --identifier "$BUNDLE_ID" "$APP"
codesign -dr - "$APP" 2>&1 | grep designated
echo "built $APP"
