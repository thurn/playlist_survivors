<Project Sdk="Microsoft.NET.Sdk">
  <!-- The same sources Unity compiles as the Demo3D.Choreography assembly. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>Demo3D.Choreography</RootNamespace>
    <!-- Optimized in every configuration, so `dotnet test` (Debug by default) times the layer
         as a player build would run it (TD3: the song must build in under 3 s). -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Demo3D/Choreography/**/*.cs" />
  </ItemGroup>
</Project>
