<Project Sdk="Microsoft.NET.Sdk">
  <!-- The same sources Unity compiles as the Demo3D.Choreography assembly: demo3d's file loading
       and evidence tables over the shared package. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>Demo3D.Choreography</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Demo3D/Choreography/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../PS.Choreography/PS.Choreography.csproj" />
  </ItemGroup>
</Project>
