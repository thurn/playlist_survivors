// The effect runtime's kernels (effects.md, The runtime): one pool of particles shared by every
// emitter definition, a dead list and two alive lists. Each frame: Begin, Allocate (one thread
// per new emitter instance: all or none of its particles, else the spawn is rejected and
// counted), Emit (one thread per new particle), FinishEmit, Simulate (curves through the lookup
// rows; survivors go to the next alive list and to their draw bucket, alpha-blended billboards
// with a back-to-front sort key), PostSim. Randomness hashes the instance seed and the
// particle's index, so fixed-time captures reproduce exactly.
#pragma kernel Init
#pragma kernel Begin
#pragma kernel Allocate
#pragma kernel Emit
#pragma kernel FinishEmit
#pragma kernel Simulate
#pragma kernel PostSim
#pragma kernel Pad

#include "EffectCommon.hlsl"

RWStructuredBuffer<Particle> _Particles;
RWStructuredBuffer<uint> _Dead;
RWStructuredBuffer<uint> _AliveIn;
RWStructuredBuffer<uint> _AliveOut;
RWStructuredBuffer<uint> _Counters;
RWStructuredBuffer<uint> _Args;
RWStructuredBuffer<Instance> _Instances;
StructuredBuffer<uint4> _FrameInst;  // ring index, first new particle, count, 0
RWStructuredBuffer<uint> _DrawList;  // bucket b at b * _BucketCap
RWStructuredBuffer<uint2> _SortList; // key, particle (bucket 0 only)

uint _PoolSize, _BucketCap, _FrameInstCount, _NewParticles, _SortSize, _Buckets, _MeshBuckets;
float _Now, _DeltaTime;
float3 _CamPos, _CamFwd;

[numthreads(256, 1, 1)]
void Init(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _PoolSize) _Dead[id.x] = _PoolSize - 1 - id.x;
    if (id.x == 0)
    {
        _Counters[C_ALIVE] = 0;
        _Counters[C_DEAD] = _PoolSize;
        _Counters[C_ALLOC] = 0;
        _Counters[C_REJECT] = 0;
        _Counters[C_NEXT] = 0;
        _Counters[C_EMITTED] = 0;
        for (uint b = 0; b < MAX_BUCKETS; b++) _Counters[C_BUCKET + b] = 0;
    }
}

[numthreads(1, 1, 1)]
void Begin(uint3 id : SV_DispatchThreadID)
{
    _Counters[C_ALLOC] = 0;
    _Counters[C_REJECT] = 0; // rejections are read back per frame
    _Counters[C_EMITTED] = 0;
    _Counters[C_NEXT] = 0;
    for (uint b = 0; b < MAX_BUCKETS; b++) _Counters[C_BUCKET + b] = 0;
}

[numthreads(64, 1, 1)]
void Allocate(uint3 id : SV_DispatchThreadID)
{
    // One thread per spawn (its leader instance, .w = the spawn's instance count): all of the
    // spawn's particles are allocated, or the whole spawn is rejected and counted.
    if (id.x >= _FrameInstCount) return;
    uint4 fi = _FrameInst[id.x];
    if (fi.w == 0) return;
    uint last = min(id.x + fi.w, _FrameInstCount);
    uint end = last < _FrameInstCount ? _FrameInst[last].y : _NewParticles;
    uint total = end - fi.y;
    uint old = 0;
    bool ok = true;
    if (total > 0)
    {
        InterlockedAdd(_Counters[C_ALLOC], total, old);
        if (old + total > _Counters[C_DEAD])
        {
            uint ignore;
            InterlockedAdd(_Counters[C_ALLOC], (uint)(-(int)total), ignore);
            InterlockedAdd(_Counters[C_REJECT], 1, ignore);
            ok = false;
        }
    }
    for (uint k = id.x; k < last; k++)
    {
        uint4 fk = _FrameInst[k];
        _Instances[fk.x].alloc.z = asfloat(ok ? old + (fk.y - fi.y) : 0xFFFFFFFFu);
    }
}

float3 SampleShape(uint e, uint seed, uint j, uint perStep, out float3 dir)
{
    float4 s0 = EM(e, S_SHAPE0), s1 = EM(e, S_SHAPE1), s2 = EM(e, S_SHAPE2);
    uint type = (uint)s0.x;
    float radius = s0.y, thick = s0.z, angle = s0.w, arc = s1.x;
    float u1 = Rand(seed, 11), u2 = Rand(seed, 12), u3 = Rand(seed, 13);
    // Arc: random, or spread evenly over the particles of one burst step.
    float theta = s1.y > 0.5 && perStep > 1 ? arc * ((j % perStep) / (float)perStep) : arc * u1;
    float3 p = 0;
    dir = float3(0, 0, 1);
    if (type == SHAPE_SPHERE || type == SHAPE_HEMISPHERE)
    {
        float z = 1 - 2 * u2;
        if (type == SHAPE_HEMISPHERE) z = abs(z);
        float r2 = sqrt(saturate(1 - z * z));
        float phi = 6.2831853 * u1;
        dir = float3(r2 * cos(phi), r2 * sin(phi), z);
        float r = radius * (1 - thick * (1 - pow(u3, 1.0 / 3.0)));
        p = dir * r;
    }
    else if (type == SHAPE_CONE || type == SHAPE_CONEVOLUME)
    {
        float r = sqrt(1 - thick * u2);
        float2 xy = float2(cos(theta), sin(theta)) * r;
        p = float3(xy * radius, 0);
        dir = normalize(float3(xy * sin(angle), cos(angle)));
        if (type == SHAPE_CONEVOLUME) p += dir * s1.z * u3 / max(cos(angle), 1e-3);
    }
    else if (type == SHAPE_CIRCLE)
    {
        float r = radius * sqrt(1 - thick * u2);
        float2 xy = float2(cos(theta), sin(theta));
        p = float3(xy * r, 0);
        dir = float3(xy, 0);
    }
    else if (type == SHAPE_BOX)
    {
        p = (float3(u1, u2, u3) - 0.5) * s2.xyz;
        dir = float3(0, 0, 1);
    }
    else if (type == SHAPE_EDGE)
    {
        p = float3((u1 * 2 - 1) * radius, 0, 0);
        dir = float3(0, 1, 0);
    }
    float4 q = EM(e, S_SHAPEROT);
    float3 sp = EM(e, S_SHAPEPOS).xyz;
    p = sp + RotateQ(q, p * EM(e, S_SHAPESCALE).xyz);
    dir = RotateQ(q, dir);
    float randomDir = s1.w, spherical = s2.w;
    if (randomDir > 0)
    {
        float z = 1 - 2 * Rand(seed, 14), phi = 6.2831853 * Rand(seed, 15), r2 = sqrt(saturate(1 - z * z));
        dir = normalize(lerp(dir, float3(r2 * cos(phi), r2 * sin(phi), z), randomDir) + 1e-5);
    }
    if (spherical > 0 && dot(p - sp, p - sp) > 1e-8) dir = normalize(lerp(dir, normalize(p - sp), spherical) + 1e-5);
    return p;
}

[numthreads(64, 1, 1)]
void Emit(uint3 id : SV_DispatchThreadID)
{
    uint k = id.x;
    if (k >= _NewParticles || _FrameInstCount == 0) return;
    // The frame instance whose range holds k.
    uint lo = 0, hi = _FrameInstCount - 1;
    while (lo < hi)
    {
        uint mid = (lo + hi + 1) >> 1;
        if (_FrameInst[mid].y <= k) lo = mid; else hi = mid - 1;
    }
    uint4 fi = _FrameInst[lo];
    uint j = k - fi.y;
    if (j >= fi.z) return;
    Instance inst = _Instances[fi.x];
    uint offset = asuint(inst.alloc.z);
    if (offset == 0xFFFFFFFFu) return;
    uint slot = _Dead[_Counters[C_DEAD] - 1 - (offset + j)];

    uint e = asuint(inst.timing.z);
    uint seed = Hash3(asuint(inst.timing.w), j, (uint)EM(e, S_MOD).x);
    uint flags = EFlags(e);

    // Birth time from the emission segments.
    float birth = 0;
    uint perStep = 1;
    [unroll] for (int s = 0; s < 4; s++)
    {
        float4 seg = inst.seg[s];
        if (seg.y > 0 && j >= (uint)seg.x)
        {
            perStep = (uint)seg.y;
            birth = seg.z + floor((j - (uint)seg.x) / seg.y) * seg.w;
        }
    }

    float4 life = EM(e, S_LIFE);
    float r = Rand(seed, 1);
    Particle p;
    float lifetime = lerp(life.x, life.y, r);
    if (flags & F_BEAM) lifetime = max(inst.alloc.w, 0.05); // a beam lasts as long as its spawn asks
    float speed = lerp(life.z, life.w, Rand(seed, 2));
    float rs = Rand(seed, 3);
    float3 size = lerp(EM(e, S_SIZEMIN).xyz, EM(e, S_SIZEMAX).xyz, (flags & F_SIZE3D) ? float3(rs, Rand(seed, 4), Rand(seed, 5)) : rs.xxx);
    if (!(flags & F_SIZE3D)) size = size.xxx;
    float3 rot = lerp(EM(e, S_ROTMIN).xyz, EM(e, S_ROTMAX).xyz, float3(Rand(seed, 6), Rand(seed, 7), Rand(seed, 8)));
    if ((flags & F_RANDROTDIR) && Rand(seed, 9) < 0.5) rot = -rot;
    float4 col = EM(e, S_COLA);
    if (flags & F_STARTGRADIENT) col = LutRow(ERow(e) + R_STARTCOLOR, Rand(seed, 10));
    else if (flags & F_STARTCOLOR2) col = lerp(EM(e, S_COLA), EM(e, S_COLB), Rand(seed, 10));

    float3 dir;
    float3 lp = SampleShape(e, seed, j - 0, perStep, dir);
    float3 lv = dir * speed;
    float birthAbs = inst.timing.x + birth;
    Frame f = EmitterFrame(inst, e, birthAbs);
    float inherit = EM(e, S_ROTMIN).w;
    if (flags & F_LOCAL)
    {
        if (inherit != 0) lv += FrameInverseVector(f, inst.velScale.xyz * inherit);
        p.posAge.xyz = lp;
        p.velLife.xyz = lv;
    }
    else
    {
        p.posAge.xyz = FramePoint(f, lp);
        p.velLife.xyz = FrameVector(f, lv) + inst.velScale.xyz * inherit;
    }
    p.posAge.w = _Now - birthAbs - _DeltaTime; // Simulate adds this frame's step
    p.velLife.w = max(lifetime, 1e-3);
    p.rotInst = float4(rot, asfloat(fi.x));
    if (!(flags & F_SHAPESCALEONLY)) size *= f.scale;
    p.sizeSeed = float4(size, asfloat(seed));
    // TD11's merge cut: a spawn standing for k coincident identical spawns carries their
    // combined density (additive: k times the light; alpha: the coverage of k layers).
    float density = max(inst.alloc.y, 1);
    if (density > 1)
    {
        float mergeBlend = EM(e, S_MAT1).x;
        if (mergeBlend < 0.5) col.rgb *= density;
        else
        {
            float a1 = saturate(col.a);
            float a2 = 1 - pow(1 - a1, density);
            if (mergeBlend > 1.5) col.rgb *= a2 / max(a1, 1e-4); // premultiplied
            col.a = a2;
        }
    }
    p.color = col;
    float4 tex = EM(e, S_TEX);
    float tiles = max(1, tex.y * tex.z);
    p.vEff = float4(p.velLife.xyz, 0);
    p.misc = float4(asfloat(e), floor(Rand(seed, 16) * EM(e, S_MOD).y * tiles), Rand(seed, 17), birthAbs);
    _Particles[slot] = p;
    uint at;
    InterlockedAdd(_Counters[C_ALIVE], 1, at);
    _AliveIn[at] = slot;
    InterlockedAdd(_Counters[C_EMITTED], 1, at);
}

[numthreads(1, 1, 1)]
void FinishEmit(uint3 id : SV_DispatchThreadID)
{
    uint alloc = _Counters[C_ALLOC];
    _Counters[C_DEAD] = _Counters[C_DEAD] - min(alloc, _Counters[C_DEAD]);
    uint alive = _Counters[C_ALIVE];
    _Args[0] = (alive + 255) / 256;
    _Args[1] = 1;
    _Args[2] = 1;
}

// A cheap divergence-free noise: the curl of three phase-shifted sine fields. It stands in for
// Shuriken's noise module, which it cannot match exactly (effects.md).
float3 CurlNoise(float3 p)
{
    float3 a = sin(p.yzx * 1.7 + float3(0.0, 1.3, 2.9)) + sin(p.zxy * 2.9 + float3(4.1, 0.7, 5.3)) * 0.5;
    float3 b = cos(p.yzx * 1.7 + float3(0.0, 1.3, 2.9)) * 1.7 + cos(p.zxy * 2.9 + float3(4.1, 0.7, 5.3)) * 1.45;
    return float3(b.y - b.z, b.z - b.x, b.x - b.y) * 0.35 + (a - a.yzx) * 0.15;
}

[numthreads(256, 1, 1)]
void Simulate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Counters[C_ALIVE]) return;
    uint slot = _AliveIn[id.x];
    Particle p = _Particles[slot];
    uint e = asuint(p.misc.x);
    uint flags = EFlags(e);
    float ageBefore = p.posAge.w;
    float age = ageBefore + _DeltaTime;
    p.posAge.w = age;
    uint at;
    if (age >= p.velLife.w)
    {
        InterlockedAdd(_Counters[C_DEAD], 1, at);
        _Dead[at] = slot;
        return;
    }
    if (age >= 0)
    {
        float dt = min(_DeltaTime, age);
        float t = age / p.velLife.w;
        float rnd = p.misc.z;
        Instance inst = _Instances[asuint(p.rotInst.w)];
        Frame f = EmitterFrame(inst, e, _Now);
        bool local = (flags & F_LOCAL) != 0;
        float3 g = float3(0, -9.81 * EM(e, S_SIZEMIN).w, 0);
        float3 acc = local ? FrameInverseVector(f, g) : g;
        if (flags & F_FORCE)
        {
            float3 force = Lut2(e, R_FORCE, R_FORCE2, (flags & F_FORCE2) != 0, t, rnd).xyz;
            bool world = (flags & F_FORCEWORLD) != 0;
            acc += local == world ? (local ? FrameInverseVector(f, force) : FrameVector(f, force)) : force;
        }
        p.velLife.xyz += acc * dt;
        if (flags & F_LIMIT)
        {
            float lim = Lut(e, R_MISC, t).z * (local ? 1 : f.scale);
            float spd = length(p.velLife.xyz);
            if (spd > lim && spd > 1e-5)
            {
                float k = 1 - pow(saturate(1 - EM(e, S_ROTMAX).w), dt * 30);
                p.velLife.xyz *= lerp(1, lim / spd, k);
            }
        }
        float3 v = p.velLife.xyz;
        if (flags & F_VEL)
        {
            float3 vol = Lut2(e, R_VEL, R_VEL2, (flags & F_VEL2) != 0, t, rnd).xyz;
            bool world = (flags & F_VELWORLD) != 0;
            v += local == world ? (local ? FrameInverseVector(f, vol) : FrameVector(f, vol)) : vol;
        }
        if (flags & F_ORBITAL)
        {
            // Orbital and radial velocity about the emitter's centre (plus its offset), in its own axes.
            float4 orb = Lut(e, R_ORBITAL, t);
            float3 off = EM(e, S_ORBITAL).xyz;
            if (local)
            {
                float3 rel = p.posAge.xyz - off;
                v += cross(orb.xyz, rel) + (dot(rel, rel) > 1e-8 ? normalize(rel) * orb.w : 0);
            }
            else
            {
                float3 rel = p.posAge.xyz - FramePoint(f, off);
                float3 w = RotateY(f.yaw, RotateQ(f.childRot, orb.xyz));
                v += cross(w, rel) + (dot(rel, rel) > 1e-8 ? normalize(rel) * orb.w * f.scale : 0);
            }
        }
        if (flags & F_NOISE)
        {
            float4 n = EM(e, S_NOISE);
            float3 q = p.posAge.xyz * n.y + (_Now * n.z + Rand(asuint(p.sizeSeed.w), 30) * 17).xxx;
            v += CurlNoise(q) * n.x * (n.w > 0.5 ? 1 : 1);
        }
        p.posAge.xyz += v * dt;
        p.vEff = float4(v, 0);
        if (flags & F_ROTLIFE)
        {
            float4 m = Lut(e, R_MISC, t);
            p.rotInst.z += lerp(m.x, m.y, rnd) * dt;
            if (flags & F_ROTAXES)
            {
                float4 r3 = Lut(e, R_ROT3, t);
                p.rotInst.xy += float2(lerp(r3.x, r3.y, rnd), lerp(r3.z, r3.w, rnd)) * dt;
            }
        }
    }
    InterlockedAdd(_Counters[C_NEXT], 1, at);
    _AliveOut[at] = slot;
    _Particles[slot] = p;
    if (age < 0) return;

    // Draw bucket: 0 alpha billboards (sorted), 1 additive billboards, then two per mesh.
    float4 r0 = EM(e, S_RENDER0), r1 = EM(e, S_RENDER1);
    uint blend = (uint)EM(e, S_MAT1).x;
    uint bucket = (uint)r0.x == RM_MESH ? 2 + 2 * (uint)r1.w + (blend == 0 ? 1 : 0) : (blend == 0 ? 1 : 0);
    if (bucket >= _Buckets) return;
    uint n;
    InterlockedAdd(_Counters[C_BUCKET + bucket], 1, n);
    if (n >= _BucketCap) return;
    _DrawList[bucket * _BucketCap + n] = slot;
    if (bucket == 0 && n < _SortSize)
    {
        float3 wp = p.posAge.xyz;
        if (flags & F_LOCAL)
        {
            Instance inst = _Instances[asuint(p.rotInst.w)];
            wp = FramePoint(EmitterFrame(inst, e, _Now), wp);
        }
        float depth = max(0, dot(wp - _CamPos, _CamFwd) - r1.z);
        _SortList[n] = uint2(~asuint(depth), slot); // ascending keys: far first
    }
}

[numthreads(1, 1, 1)]
void PostSim(uint3 id : SV_DispatchThreadID)
{
    _Counters[C_ALIVE] = _Counters[C_NEXT];
    for (uint b = 0; b < _Buckets; b++)
        _Args[4 + b * 4 + 1] = min(_Counters[C_BUCKET + b], _BucketCap);
}

// Pads the sort list past bucket 0's count with keys that sort last.
[numthreads(256, 1, 1)]
void Pad(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _SortSize && id.x >= _Counters[C_BUCKET]) _SortList[id.x] = uint2(0xFFFFFFFFu, 0xFFFFFFFFu);
}
