// The palette skinning variant (crowd.md, Two skinning variants): once per frame, blend each
// visible (camera or shadow) instance's bones into a palette, 3 float4 rows per bone, indexed by
// the instance's stable slot. Every draw pass then reads 4 matrices per vertex. The previous
// frame's palette is kept for motion vectors, with each slot's frame stamp.
#pragma kernel Blend

#include "CrowdSkinning.hlsl"

StructuredBuffer<MonsterInstance> _Instances;
StructuredBuffer<uint> _VisibleFlags;
RWStructuredBuffer<float4> _PaletteOut;
RWStructuredBuffer<uint> _StampOut;
uint _Count, _BoneCount, _CrowdFrame;
float _ClipRate; // the type's bone texture rate: 60, or 30 under the clips30 cut

[numthreads(64, 1, 1)]
void Blend(uint3 id : SV_DispatchThreadID)
{
    uint slot = id.x / _BoneCount;
    uint bone = id.x - slot * _BoneCount;
    if (slot >= _Count || _VisibleFlags[slot] == 0) return;
    float3x4 m = BlendBone(SampleOf(_Instances[slot], _ClipRate), bone);
    uint at = id.x * 3;
    _PaletteOut[at] = m[0];
    _PaletteOut[at + 1] = m[1];
    _PaletteOut[at + 2] = m[2];
    if (bone == 0) _StampOut[slot] = _CrowdFrame;
}
