<Project Sdk="Microsoft.NET.Sdk">
  <!-- The same sources Unity compiles as the Demo2D.Choreography assembly: demo2d's file loading
       over the shared package. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>Demo2D.Choreography</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Demo2D/Choreography/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../PS.Choreography/PS.Choreography.csproj" />
  </ItemGroup>
</Project>
