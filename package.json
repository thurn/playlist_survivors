{
  "name": "playlist-survivors",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "port": "tsx -e \"import('./scripts/lib/port.ts').then((m) => console.log(m.devPort()))\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test:e2e": "playwright test",
    "analysis": "uv run --project tools/analysis ps-analysis",
    "bake": "tsx tools/baker/bake.ts",
    "bake:contact-sheet": "tsx tools/baker/contact-sheet.ts",
    "check:assets": "tsx tools/baker/check-assets.ts",
    "check:songmap": "uv run --project tools/analysis ps-analysis check songs/orpheus-galop/songmap.json",
    "check:content": "tsx scripts/check-content.ts",
    "check:plan": "tsx scripts/check-plan.ts --casual",
    "check:determinism": "tsx scripts/check-plan.ts --determinism",
    "capture": "tsx scripts/capture.ts",
    "bench": "tsx scripts/bench.ts",
    "check:all": "npm run check && npm run check:analysis && npm run check:songmap && npm run check:content && npm run check:assets && npm run check:seeds && npm run check:play && npm run test:e2e",
    "check:analysis": "uv run --directory tools/analysis pytest -q && uv run --directory tools/analysis ruff check .",
    "check:play": "tsx scripts/check-play.ts",
    "check:seeds": "tsx scripts/check-plan.ts --seeds=1858,1859,7,2024 --determinism",
    "qa": "tsx scripts/qa.ts",
    "log:play": "tsx scripts/play-log.ts",
    "reactive:add": "tsx scripts/reactive-add.ts",
    "reactive:streams": "tsx scripts/reactive-streams.ts"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wasm-media-encoders": "^0.7.0"
  }
}
