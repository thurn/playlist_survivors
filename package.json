{
  "name": "playlist-survivors",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test:e2e": "playwright test",
    "analysis": "uv run --project tools/analysis ps-analysis",
    "bake": "tsx tools/baker/bake.ts",
    "bake:contact-sheet": "tsx tools/baker/contact-sheet.ts",
    "check:assets": "tsx tools/baker/check-assets.ts",
    "check:songmap": "uv run --project tools/analysis ps-analysis check songs/orpheus-galop/songmap.json",
    "check:content": "tsx scripts/check-content.ts",
    "check:plan": "tsx scripts/check-plan.ts",
    "check:determinism": "tsx scripts/check-plan.ts --determinism",
    "capture": "tsx scripts/capture.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wasm-media-encoders": "^0.7.0"
  }
}
