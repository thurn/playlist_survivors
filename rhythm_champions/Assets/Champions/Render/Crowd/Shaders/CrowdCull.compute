// The crowd's culling pass (game/'s, ported and cut down: no LODs, depth bins or shadows), once per type per
// frame: each instance's bounding sphere against the camera's frustum; the visible go into one list, which both
// the body's and the lines' indirect draws read (each command's instance count is the list's length). A dying
// instance (its death's frame) is drawn by neither but flagged for the palette pass, whose pose the shatter's
// pieces start from.
#pragma kernel ClearArgs
#pragma kernel Cull

#include "CrowdSkinning.hlsl"

#define ARGS_STRIDE 20 // IndirectDrawIndexedArgs: 5 uints

StructuredBuffer<MonsterInstance> _Instances;
RWByteAddressBuffer _Args;                 // [body, lines]
RWStructuredBuffer<uint> _VisibleListOut;
RWStructuredBuffer<uint> _VisibleFlags;    // 1 drawn, 4 dying
float4 _FrustumPlanes[6];
uint _Count;

bool Inside(float3 c, float r)
{
    [unroll]
    for (int i = 0; i < 6; i++)
        if (dot(_FrustumPlanes[i].xyz, c) + _FrustumPlanes[i].w < -r) return false;
    return true;
}

[numthreads(1, 1, 1)]
void ClearArgs(uint3 id : SV_DispatchThreadID)
{
    _Args.Store(4, 0);
    _Args.Store(ARGS_STRIDE + 4, 0);
}

[numthreads(64, 1, 1)]
void Cull(uint3 id : SV_DispatchThreadID)
{
    uint slot = id.x;
    if (slot >= _Count) return;
    MonsterInstance m = _Instances[slot];
    if ((m.flags & CROWD_HIDDEN) != 0 || m.scale <= 0)
    {
        _VisibleFlags[slot] = 0;
        return;
    }
    if ((m.flags & CROWD_DYING) != 0)
    {
        _VisibleFlags[slot] = 4;
        return;
    }
    float4 sphere = CrowdSphere(m);
    if (!Inside(sphere.xyz, sphere.w * 1.1))
    {
        _VisibleFlags[slot] = 0;
        return;
    }
    _VisibleFlags[slot] = 1;
    uint at, ignored;
    _Args.InterlockedAdd(4, 1, at);
    _Args.InterlockedAdd(ARGS_STRIDE + 4, 1, ignored);
    _VisibleListOut[at] = slot;
}
